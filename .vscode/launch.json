{
    "version": "0.2.0",
    "configurations": [
        {
            // F5: собрать и запустить сервер под отладчиком
            "name": "dejaview-backend",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dejaview-backend",
            "cwd": "${workspaceFolder}",
            // переменные окружения из .env (создать: cp .env.example .env)
            "envFile": "${workspaceFolder}/.env",
            "MIMode": "gdb",
            "preLaunchTask": "build",
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true},
                // Docker запрещает отключать рандомизацию адресов; без этого gdb печатает предупреждение
                {"text": "set disable-randomization off"}
            ]
        }
    ]
}
