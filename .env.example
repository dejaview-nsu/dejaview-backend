# Порт HTTP-сервера внутри контейнера. Необязательный, по умолчанию 8081.
PORT=8081

# PostgreSQL, обязательный. Пример - БД из dejaview-infra (порт 57432 на Mac).
# host.docker.internal - адрес Mac изнутри контейнера (dev-контейнер или docker run).
DATABASE_URL=postgres://dejaview:dejaview_local_only@host.docker.internal:57432/dejaview?sslmode=disable

# Адрес frontend для ссылок в письмах, обязательный. Пример - frontend из dejaview-infra.
APP_URL=http://localhost:57437

# Серверный ключ Yandex SmartCaptcha. Пусто - CAPTCHA при входе отключена: так можно только
# локально, в продакшене ключ обязателен.
SMARTCAPTCHA_SERVER_KEY=

# Почтовый сервер, обязательный. Локально - Mailpit из compose.yaml (docker compose up -d mailpit),
# письма видно на http://localhost:8025. В продакшене - smtps://<сервер>:465 и учётные данные.
SMTP_URL=smtp://host.docker.internal:1025
SMTP_FROM=noreply@dejaview.local
SMTP_USER=
SMTP_PASSWORD=

# Публичный адрес backend для redirect_uri входа через OIDC. Не задан - APP_URL: в продакшене
# frontend и API на одном домене. Локально backend на своём порту.
API_URL=http://localhost:8081

# Вход через Яндекс: приложение на oauth.yandex.ru, Redirect URI -
# {API_URL}/api/v1/auth/oidc/yandex/callback. Не заданы - вход через Яндекс выключен.
OIDC_YANDEX_CLIENT_ID=
OIDC_YANDEX_CLIENT_SECRET=

# Вход через Google: console.cloud.google.com, клиент Web application, Authorized redirect URI -
# {API_URL}/api/v1/auth/oidc/google/callback. Не заданы - вход через Google выключен.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

# Вход через VK ID: кабинет id.vk.com/about/business/go, доверенный Redirect URL -
# {API_URL}/api/v1/auth/oidc/vk/callback. Только ID приложения: секрет VK ID не нужен (PKCE).
OIDC_VK_CLIENT_ID=
