meta {
  name: Вход с неверным паролем
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{username}}",
    "password": "wrong"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq AUTH_INVALID_CREDENTIALS
  res.body.captcha_required: eq false
}

docs {
  Каждый неверный пароль +1 к счётчику: с 3-го подряд нужна CAPTCHA, после 5-го - блокировка на
  15 минут. Верный вход счётчик обнуляет.
}
