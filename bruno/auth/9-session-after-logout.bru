meta {
  name: Сессия после выхода
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/auth/session
  body: none
  auth: none
}

headers {
  Cookie: dv_session={{session}}
}

assert {
  res.status: eq 401
  res.body.code: eq SESSION_EXPIRED
}

docs {
  Прежняя cookie после выхода не действует: строки сессии в БД больше нет.
}
