meta {
  name: Повторная отправка письма
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/resend-confirmation
  body: json
  auth: none
}

body:json {
  {
    "login": "{{email}}"
  }
}

assert {
  res.status: eq 202
}

docs {
  Email уже подтверждён - письмо не уходит, но ответ тот же, что при отправке: по нему нельзя
  узнать, зарегистрирован ли адрес.
}
