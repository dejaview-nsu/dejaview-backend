meta {
  name: Подтверждение email
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/confirm-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{confirmToken}}"
  }
}

script:post-response {
  // У dv_session флаг Secure: по http клиент может её не сохранить. Берём токен из Set-Cookie
  // сами и дальше передаём заголовком Cookie
  const cookies = [].concat(res.getHeader("set-cookie") || []).join("; ");
  const match = cookies.match(/dv_session=([^;]+)/);
  if (match) {
    bru.setVar("session", match[1]);
  }
}

assert {
  res.status: eq 200
  res.body.user.username: eq {{username}}
}
