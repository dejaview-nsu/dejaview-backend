meta {
  name: Вход
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const cookies = [].concat(res.getHeader("set-cookie") || []).join("; ");
  const match = cookies.match(/dv_session=([^;]+)/);
  if (match) {
    bru.setVar("session", match[1]);
  }
}

assert {
  res.status: eq 200
  res.body.user.username: eq {{username}}
}
