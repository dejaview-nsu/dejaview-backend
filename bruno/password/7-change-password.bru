meta {
  name: Смена пароля из профиля
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/users/me/password
  body: json
  auth: none
}

headers {
  Cookie: dv_session={{session}}
}

body:json {
  {
    "current_password": "Kino#2027",
    "new_password": "Kino#2028"
  }
}

assert {
  res.status: eq 204
}

docs {
  Сессия - из «Новый пароль». Все сессии пользователя, кроме этой, завершаются, письмо «Пароль
  изменён» - в Mailpit. У учётной записи без пароля (из OIDC) `current_password` не передаётся.
}
