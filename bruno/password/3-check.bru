meta {
  name: Проверка ссылки
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/password-reset/check
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Страница SPA по ссылке из письма проверяет её до показа формы «Новый пароль». Ссылка не
  расходуется, запрос можно повторять. Истекла, заменена новой или использована - 410.
}
