meta {
  name: Новый пароль
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/password-reset/complete
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "new_password": "Kino#2027"
  }
}

script:post-response {
  const cookies = [].concat(res.getHeader("set-cookie") || []).join("; ");
  const match = cookies.match(/dv_session=([^;]+)/);
  if (match) {
    bru.setVar("session", match[1]);
  }
}

assert {
  res.status: eq 200
  res.body.user.username: eq {{username}}
}

docs {
  Все прежние сессии пользователя завершаются, создаётся новая - пользователь сразу вошёл. Ссылка
  одноразовая: повторный запрос - 410. Письмо «Пароль изменён» - в Mailpit.
}
