# Стиль как у Drogon: основа Google, отличия ниже.
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -2
ColumnLimit: 100
# фигурные скобки на отдельной строке
BreakBeforeBraces: Allman
# & и * у имени: const HttpRequestPtr &request
DerivePointerAlignment: false
PointerAlignment: Right
# группы #include, разделённые пустой строкой, не смешивать; внутри группы - по алфавиту
IncludeBlocks: Preserve
InsertNewlineAtEOF: true
